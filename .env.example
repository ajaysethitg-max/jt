# ─────────────────────────────────────────────────────────────────────────────
# Jeet Telecom — environment variables
# Copy to .env and fill in what you use. Nothing here is required for local dev.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server mode (Node + Postgres: Render, Railway, Fly.io, VPS, Docker) ─────
# Migrations run and the demo catalogue is seeded automatically on first boot.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Google Sheet → Postgres sync (server mode) ──────────────────────────────
# A sheet shared as "Anyone with the link · Viewer". Sync from /admin/sync.
GOOGLE_SHEET_ID=
# GOOGLE_SHEET_TAB_PRODUCTS=Products
# GOOGLE_SHEET_TAB_DEALS=Deals
# GOOGLE_SHEET_TAB_REVIEWS=Reviews
# GOOGLE_SHEET_TAB_SETTINGS=Settings

# ── Static mode (GitHub Pages) ───────────────────────────────────────────────
# These are set for you by .github/workflows/deploy-pages.yml — do not put them
# in .env. Manage them as GitHub "Variables" / "Secrets" (Settings → Actions).
#
# NEXT_PUBLIC_STATIC_BUILD=true                         # emit static files to out/
# NEXT_PUBLIC_BASE_PATH=/<repository-name>              # "" for user.github.io repos
# NEXT_PUBLIC_GOOGLE_SHEET_ID=                          # Variable — live catalogue source
# NEXT_PUBLIC_GOOGLE_SHEETS_API_KEY=                    # Secret  — optional, faster sheet reads
# NEXT_PUBLIC_CATALOG_CSV_BASE_URL=                     # Variable — optional fallback: CSV folder
